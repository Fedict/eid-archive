#!/usr/bin/make -f

%: 
	dh $@

override_dh_auto_build:

override_dh_install: released.gpg develop.gpg
	dh_install

override_dh_auto_clean:
	rm -f *.gpg
	dh_auto_clean

override_dh_builddeb:
	dh_builddeb -- --no-uniform-compression

released.gpg: 6773d225.asc 67da21a4.asc
	gpg --dearmor < 67da21a4.asc > released.gpg

develop.gpg: 10a04d46.asc 09089348.asc
	gpg --dearmor < 09089348.asc > develop.gpg
